# Database
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Base URL
BASE_URL=http://localhost:3000

# AI Provider (Groq)
GROQ_API_KEY=

# Web Search & Scraping (Firecrawl)
FIRECRAWL_API_KEY=

# Customer data sources (bring your own key). Each organization connects its
# own Apollo account in Settings > Data sources; campaigns run on its key and
# credits. Secrets are encrypted with ENCRYPTION_KEY only (32+ characters, no
# fallback to BETTER_AUTH_SECRET); without it connecting and running fail closed.
ENCRYPTION_KEY=
# Apollo credits one campaign may spend on the customer's account, all attempts. Default 25.
APOLLO_RUN_CREDIT_CAP=25
# Pacing per customer connection (Apollo plans differ). Defaults 20/min, 1 at a time.
APOLLO_REQUESTS_PER_MINUTE=20
APOLLO_MAX_CONCURRENCY=1
# Connect attempts per organization per hour (each makes one free Apollo call). Default 10.
GTM_DATA_SOURCE_CONNECTS_PER_HOUR=10

# Platform-paid data, ONLY for these internal organization ids (comma-separated).
# Every other organization needs a connected Apollo account to start a campaign.
PLATFORM_DATA_ORG_IDS=
# Which platform data those organizations get. firecrawl (default): people
# search and work emails through Firecrawl's data API (FIRECRAWL_API_KEY above),
# billed in Firecrawl credits. legacy: the previous Apollo + FullEnrich path.
# none: no platform data for anyone.
PEOPLE_DATA_PROVIDER=firecrawl
# Firecrawl data credits allowed per calendar month, all campaigns. Default 3000.
FIRECRAWL_MONTHLY_CREDIT_CAP=3000
# Firecrawl data credits one campaign may spend, all attempts. Default 1200.
FIRECRAWL_RUN_CREDIT_CAP=1200
# People one campaign's search reads at most (5 credits each). Default 150, ceiling 600.
GTM_PEOPLE_SEARCH_CANDIDATE_CAP=150
# live = real vendor calls, fixture = recorded/synthetic responses with zero network calls
GTM_PROVIDER_MODE=live
# Companies kept per Stage 4 run (the people search stops paging once it has
# this many). Default 15, hard ceiling 25.
GTM_MAX_COMPANIES_PER_RUN=15

# Verified-only email lookup (Stage 5). Only an address the vendor verified at
# mailbox level is ever stored, qualified or sent; nothing is guessed.
# Verified leads one campaign searches for. Default 10, hard maximum 15.
GTM_TARGET_VERIFIED_LEADS=10
# Decision makers tried per company before moving on. Default 3, maximum 5.
GTM_MAX_CANDIDATES_PER_COMPANY=3
# Companies examined per campaign. Default 40, hard ceiling 60.
GTM_MAX_COMPANIES_EXAMINED=40
# Email lookups per campaign across restarts. Default 20, ceiling 45.
GTM_EMAIL_LOOKUPS_PER_CAMPAIGN=20
# Wall-clock limit of one search attempt, minutes. Default 15, maximum 30.
GTM_LEAD_SEARCH_MAX_MINUTES=15
# Companies searched at the same time (raised to a batch of 10 with Firecrawl). Default 3, maximum 5.
GTM_LEAD_SEARCH_CONCURRENCY=3
# Wait between lookup steps (Firecrawl: between email batches), ms. Default 15000.
GTM_EMAIL_POLL_INTERVAL_MS=15000

# ---- Legacy only (PEOPLE_DATA_PROVIDER=legacy); unused by default ----
APOLLO_API_KEY=
APOLLO_MONTHLY_CREDIT_CAP=60
# database = Apollo-backed Stage 4, legacy = Firecrawl web-search Stage 4
GTM_DISCOVERY_MODE=legacy
GTM_COMPANY_PROVIDER=apollo
# Decision-maker vendor. Only "fixture" (synthetic people, fixture mode only) exists today.
GTM_PEOPLE_PROVIDER=fixture
GTM_DECISION_MAKERS_PER_COMPANY=1
FULLENRICH_API_KEY=
FULLENRICH_MONTHLY_CREDIT_CAP=45
# Longest wait for one lookup result before it is left incomplete. Default 180.
GTM_EMAIL_LOOKUP_MAX_WAIT_SECONDS=180

# Inngest Orchestration
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Blob Storage
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Dodo Payments (Billing)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
NEXT_PUBLIC_DODO_PILOT_PRICE_ID=
NEXT_PUBLIC_DODO_STARTER_PRICE_ID=
NEXT_PUBLIC_DODO_GROWTH_PRICE_ID=
NEXT_PUBLIC_DODO_SCALE_PRICE_ID=
NEXT_PUBLIC_DODO_TOPUP_PRICE_ID=
NEXT_PUBLIC_DODO_EXTRA_SEAT_PRICE_ID=
NEXT_PUBLIC_DODO_FREELANCER_PRICE_ID=
NEXT_PUBLIC_DODO_AGENCY_PRICE_ID=
NEXT_PUBLIC_BYPASS_BILLING=false

# Cal.com Integration
CALCOM_WEBHOOK_SECRET=
CALCOM_BOOKING_URL=https://cal.com/sales-team/15min
