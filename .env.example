# Database
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Base URL
BASE_URL=http://localhost:3000

# AI Provider (Groq)
GROQ_API_KEY=

# Web Search & Scraping (Firecrawl)
FIRECRAWL_API_KEY=

# Company database (Stage 4 database mode). One key per vendor; never rotate keys.
APOLLO_API_KEY=
# Our own monthly Apollo credit budget (ledger: gtm_vendor_usage). Default 60.
APOLLO_MONTHLY_CREDIT_CAP=60
# database = Apollo-backed Stage 4, legacy = Firecrawl Stage 4 (default legacy)
GTM_DISCOVERY_MODE=legacy
# live = real vendor calls, fixture = recorded responses with zero network calls
GTM_PROVIDER_MODE=live
# Company-discovery vendor (only "apollo" today)
GTM_COMPANY_PROVIDER=apollo
# Companies per Stage 4 run. Default 15, hard ceiling 25.
GTM_MAX_COMPANIES_PER_RUN=15
# Decision-maker vendor. Only "fixture" (synthetic people, fixture mode only) exists today.
GTM_PEOPLE_PROVIDER=fixture
# Decision makers stored per selected company. Default 1, maximum 2.
GTM_DECISION_MAKERS_PER_COMPANY=1

# Verified-only email lookup (Stage 5). Only an address the vendor verified at
# mailbox level is ever stored, qualified or sent; nothing is guessed.
FULLENRICH_API_KEY=
# FullEnrich credits allowed per calendar month (vendor ledger). Default 45.
FULLENRICH_MONTHLY_CREDIT_CAP=45
# Verified leads one campaign searches for. Default 10, hard maximum 15.
GTM_TARGET_VERIFIED_LEADS=10
# Decision makers tried per company before moving on. Default 3, maximum 5.
GTM_MAX_CANDIDATES_PER_COMPANY=3
# Companies examined per campaign. Default 40, hard ceiling 60.
GTM_MAX_COMPANIES_EXAMINED=40
# Email lookups per campaign across restarts (each costs at most 1 credit). Default 20, ceiling 45.
GTM_EMAIL_LOOKUPS_PER_CAMPAIGN=20
# Wall-clock limit of one search attempt, minutes. Default 15, maximum 30.
GTM_LEAD_SEARCH_MAX_MINUTES=15
# Companies searched at the same time. Default 3, maximum 5.
GTM_LEAD_SEARCH_CONCURRENCY=3
# Longest wait for one lookup result before it is left incomplete. Default 180.
GTM_EMAIL_LOOKUP_MAX_WAIT_SECONDS=180
# Poll interval for live lookups, ms. Default 15000.
GTM_EMAIL_POLL_INTERVAL_MS=15000

# Legacy enrich.so client (src/lib/enrich.ts). No longer called by Stage 5.
ENRICH_API_KEY=

# Inngest Orchestration
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Blob Storage
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Dodo Payments (Billing)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
NEXT_PUBLIC_DODO_PILOT_PRICE_ID=
NEXT_PUBLIC_DODO_STARTER_PRICE_ID=
NEXT_PUBLIC_DODO_GROWTH_PRICE_ID=
NEXT_PUBLIC_DODO_SCALE_PRICE_ID=
NEXT_PUBLIC_DODO_TOPUP_PRICE_ID=
NEXT_PUBLIC_DODO_EXTRA_SEAT_PRICE_ID=
NEXT_PUBLIC_DODO_FREELANCER_PRICE_ID=
NEXT_PUBLIC_DODO_AGENCY_PRICE_ID=
NEXT_PUBLIC_BYPASS_BILLING=false

# Cal.com Integration
CALCOM_WEBHOOK_SECRET=
CALCOM_BOOKING_URL=https://cal.com/sales-team/15min
